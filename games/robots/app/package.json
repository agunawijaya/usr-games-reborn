{
  "name": "@bsdgames/robots-fancy-web-remastered",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "fancy-web remastered: the fancy-web robots port with a new presentation (space scene, lighting, characters, effects, sound) — React + @react-three/fiber",
  "author": "Agun Wijaya",
  "license": "MIT",
  "scripts": {
    "dev": "vite --port 5202 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5202 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:once": "vitest run"
  },
  "dependencies": {
    "@usr-games/bridge": "workspace:*",
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "^2.16.3",
    "postprocessing": "^6.35.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.2",
    "jsdom": "^25.0.1",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.3"
  }
}
